[Unit]
Description=Subsite Monitor access-log collector
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/local/bin/subsite-monitor service
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/subsite-monitor

[Install]
WantedBy=multi-user.target
