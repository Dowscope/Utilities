/var/log/subsite-monitor/access.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    create 0600 root root
    sharedscripts
    postrotate
        /usr/bin/systemctl kill --kill-whom=main --signal=USR1 nginx.service \
            >/dev/null 2>&1 || true
    endscript
}
